# Copia este archivo como ".env" y completá tus claves.
# El archivo .env NO se sube a git (está en .gitignore).

# ============================================================
#  OPCIÓN A — Gemini (una sola clave, con plan gratuito)
# ============================================================
# Cubre todo: redactar las respuestas, buscar por significado y leer
# PDF escaneados. Se saca en https://aistudio.google.com/apikey
#
# OJO: en el plan GRATUITO, Google puede usar lo que enviás para mejorar
# sus productos, y revisores humanos pueden leerlo. Para expedientes con
# datos de clientes, tenelo en cuenta. En el plan pago no lo usan.
GEMINI_API_KEY=

# Modelos. Si alguno da error 404, corré "npm run modelos" para ver los
# que tu clave tiene habilitados y poné el que corresponda.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768

# ============================================================
#  OPCIÓN B — Claude + Voyage (dos claves, ambas pagas)
# ============================================================
# Más caro, pero no usan tus datos para entrenar.
# Para usar esta opción, dejá GEMINI_API_KEY vacía.
# ANTHROPIC_API_KEY=sk-ant-...          # https://console.anthropic.com
# VOYAGE_API_KEY=pa-...                 # https://www.voyageai.com
# CLAUDE_MODEL=claude-haiku-4-5         # más económico que el modelo por defecto

# Forzar un proveedor a mano (gemini | claude). Si lo dejás vacío, se elige
# solo: usa Gemini si hay GEMINI_API_KEY, si no Claude.
# LLM_PROVIDER=

# ============================================================
#  Mega (sincronización automática del backup de juicios)
# ============================================================
# Acá no hay clave de API: son el mail y la contraseña de la cuenta.
MEGA_EMAIL=
MEGA_PASSWORD=
# (Opcional) Carpeta dentro de Mega a sincronizar. Vacío = desde la raíz.
MEGA_FOLDER=Juicios

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001
