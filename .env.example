# Copia este archivo como ".env" y completa tus claves.
# El archivo .env NO se sube a git (está en .gitignore).

# Clave de la API de Anthropic (Claude). Obtenla en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Clave de Voyage AI para los embeddings (búsqueda semántica).
# Obtenla en https://www.voyageai.com
VOYAGE_API_KEY=pa-...

# Puerto del servidor backend (opcional, por defecto 3001)
PORT=3001

# --- Mega (sincronización automática del backup de juicios) ---
# Credenciales de la cuenta de Mega donde están los juicios.
# Como la app corre solo en la PC de tu papá, queda guardado localmente.
MEGA_EMAIL=tu_email@ejemplo.com
MEGA_PASSWORD=tu_contraseña
# (Opcional) Nombre de la carpeta dentro de Mega a sincronizar.
# Si lo dejás vacío, sincroniza desde la raíz.
MEGA_FOLDER=Juicios
