{
  "name": "asistente-legal-ia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:all": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev\" \"npm run server\"",
    "start": "npm run build && node server/index.js",
    "online": "npm run build && concurrently -n app,tunel -c green,yellow \"node server/index.js\" \"npm run tunel\"",
    "tunel": "cloudflared tunnel --url http://localhost:3001",
    "usuario": "node server/scripts/usuario.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@tailwindcss/postcss": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "mammoth": "^1.11.0",
    "megajs": "^1.3.10",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
